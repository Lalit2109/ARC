        [Source = "PatchingMethod", Target = "PatchingMethod", SpType = "Choice", DvType = "Choice"],
        [Source = "OperatingSystem", Target = "OperatingSystem", SpType = "Choice", DvType = "Choice"],
        [Source = "PurchaseDate", Target = "PurchaseDate", SpType = "Text", DvType = "Text"],
        [Source = "DueDate", Target = "DueDate", SpType = "Text", DvType = "Text"],
        [Source = "R_x002d_MonthofDecom", Target = "R_x002d_MonthofDecom", SpType = "Text", DvType = "Text"],
        [Source = "R_x002d_Node4Cease", Target = "R_x002d_Node4Cease", SpType = "Text", DvType = "Text"],
        [Source = "R_x002d_PotentialCostSaving", Target = "R_x002d_PotentialCostSaving", SpType = "Text", DvType = "Text"],
        [Source = "R_x002d_ActualCostSaving", Target = "R_x002d_ActualCostSaving", SpType = "Text", DvType = "Text"],
        [Source = "CurrentOwner", Target = "CurrentOwner", SpType = "User", DvType = "Text"],
        [Source = "DecomOwner", Target = "DecomOwner", SpType = "User", DvType = "Text"],
        [Source = "_ApprovalAssignedTo", Target = "_ApprovalAssignedTo", SpType = "UserMulti", DvType = "Text"],
        [Source = "_ApprovalRespondedBy", Target = "_ApprovalRespondedBy", SpType = "UserMulti", DvType = "Text"],
        [Source = "_ApprovalSentBy", Target = "_ApprovalSentBy", SpType = "User", DvType = "Text"],
        [Source = "_ApprovalStatus", Target = "_ApprovalStatus", SpType = "Integer", DvType = "WholeNumber"],
        [Source = "R_x002d_IOSheet", Target = "R_x002d_IOSheet", SpType = "Boolean", DvType = "TwoOptions"],
        [Source = "R_x002d_ADGroups", Target = "R_x002d_ADGroups", SpType = "Boolean", DvType = "TwoOptions"],
        [Source = "R_x002d_AntiVirus", Target = "R_x002d_AntiVirus", SpType = "Boolean", DvType = "TwoOptions"],
        [Source = "R_x002d_PatchManager", Target = "R_x002d_PatchManager", SpType = "Boolean", DvType = "TwoOptions"],
        [Source = "R_x002d_DNS", Target = "R_x002d_DNS", SpType = "Boolean", DvType = "TwoOptions"],
        [Source = "R_x002d_ADObject", Target = "R_x002d_ADObject", SpType = "Boolean", DvType = "TwoOptions"],
        [Source = "R_x002d_VCenterDisk", Target = "R_x002d_VCenterDisk", SpType = "Boolean", DvType = "TwoOptions"],
        [Source = "R_x002d_IPSheet", Target = "R_x002d_IPSheet", SpType = "Boolean", DvType = "TwoOptions"],
        [Source = "R_x002d_ArchiveSnow", Target = "R_x002d_ArchiveSnow", SpType = "Boolean", DvType = "TwoOptions"],
        [Source = "R_x002d_OpenManage", Target = "R_x002d_OpenManage", SpType = "Boolean", DvType = "TwoOptions"],
        [Source = "R_x002d_DeleteVMRep", Target = "R_x002d_DeleteVMRep", SpType = "Boolean", DvType = "TwoOptions"],
        [Source = "R_x002d_DatabaseBackup", Target = "R_x002d_DatabaseBackup", SpType = "Boolean", DvType = "TwoOptions"],
        [Source = "R_x002d_Backups", Target = "R_x002d_Backups", SpType = "Boolean", DvType = "TwoOptions"],
        [Source = "R_x002d_FirewallRules", Target = "R_x002d_FirewallRules", SpType = "Boolean", DvType = "TwoOptions"],
        [Source = "R_x002d_DateofDecom", Target = "R_x002d_DateofDecom", SpType = "DateTime", DvType = "DateTime"],
        [Source = "DecomByDate", Target = "DecomByDate", SpType = "DateTime", DvType = "DateTime"],
        [Source = "ARCAgentStatus", Target = "ARCAgentStatus", SpType = "Text", DvType = "Text"],
        [Source = "ARCAgentVersion", Target = "ARCAgentVersion", SpType = "Text", DvType = "Text"],
        [Source = "ARCExtensionsEnabled", Target = "ARCExtensionsEnabled", SpType = "Text", DvType = "Text"],
        [Source = "ARCGuestConfigurationEnabled", Target = "ARCGuestConfigurationEnabled", SpType = "Text", DvType = "Text"],
        [Source = "ARCLastRefreshed", Target = "ARCLastRefreshed", SpType = "DateTime", DvType = "DateTime"],
        [Source = "isSQLServer", Target = "isSQLServer", SpType = "Text", DvType = "Text"],
        [Source = "avEngineVersion", Target = "avEngineVersion", SpType = "Text", DvType = "Text"],
        [Source = "avSignatureVersion", Target = "avSignatureVersion", SpType = "Text", DvType = "Text"],
        [Source = "avPlatformVersion", Target = "avPlatformVersion", SpType = "Text", DvType = "Text"],
        [Source = "avEngineUpdateTime", Target = "avEngineUpdateTime", SpType = "DateTime", DvType = "DateTime"],
        [Source = "avSignatureUpdateTime", Target = "avSignatureUpdateTime", SpType = "DateTime", DvType = "DateTime"],
        [Source = "avPlatformUpdateTime", Target = "avPlatformUpdateTime", SpType = "DateTime", DvType = "DateTime"],
        [Source = "avEngineUpToDate", Target = "avEngineUpToDate", SpType = "Text", DvType = "Text"],
        [Source = "avSignatureUpToDate", Target = "avSignatureUpToDate", SpType = "Text", DvType = "Text"],
        [Source = "avPlatformUpToDate", Target = "avPlatformUpToDate", SpType = "Text", DvType = "Text"],
        [Source = "avLastSeenTime", Target = "avLastSeenTime", SpType = "DateTime", DvType = "DateTime"],
        [Source = "exposureLevel", Target = "exposureLevel", SpType = "Text", DvType = "Text"],
        [Source = "InstanceID", Target = "InstanceID", SpType = "Integer", DvType = "WholeNumber"],
        [Source = "order", Target = "order", SpType = "Number", DvType = "DecimalNumber"],
        [Source = "GUID", Target = "GUID", SpType = "Guid", DvType = "UniqueIdentifier"],
        [Source = "WorkflowInstanceID", Target = "WorkflowInstanceID", SpType = "Guid", DvType = "UniqueIdentifier"],
        [Source = "Created", Target = "Created", SpType = "DateTime", DvType = "DateTime"],
        [Source = "Modified", Target = "Modified", SpType = "DateTime", DvType = "DateTime"],
        [Source = "Author", Target = "Author", SpType = "User", DvType = "Text"],
        [Source = "Editor", Target = "Editor", SpType = "User", DvType = "Text"],
        [Source = "Attachments", Target = "Attachments", SpType = "Attachments", DvType = "TwoOptions"]
    },

    ToText = (v as any) as nullable text =>
        if v = null then
            null
        else if Value.Is(v, type record) then
            if Record.HasFields(v, "Email") then Text.From(v[Email])
            else if Record.HasFields(v, "DisplayName") then Text.From(v[DisplayName])
            else if Record.HasFields(v, "Value") then Text.From(v[Value])
            else Text.FromBinary(Json.FromValue(v), TextEncoding.Utf8)
        else if Value.Is(v, type list) then
            Text.Combine(List.Transform(v, each @ToText(_)), "; ")
        else
            Text.From(v),

    ToChoiceText = (v as any) as nullable text =>
        if v = null then null
        else if Value.Is(v, type record) and Record.HasFields(v, "Value") then Text.From(v[Value])
        else ToText(v),

    ToLogical = (v as any) as nullable logical =>
        if v = null then
            null
        else if Value.Is(v, type logical) then
            v
        else
            let
                t = Text.Lower(Text.Trim(ToText(v)))
            in
                if List.Contains({"true", "yes", "y", "1"}, t) then true
                else if List.Contains({"false", "no", "n", "0"}, t) then false
                else null,

    ToInt64 = (v as any) as nullable number =>
        if v = null then null else try Int64.From(v) otherwise try Int64.FromText(ToText(v)) otherwise null,

    ToNumber = (v as any) as nullable number =>
        if v = null then null else try Number.From(v) otherwise try Number.FromText(ToText(v)) otherwise null,

    ToDateTime = (v as any) as nullable datetime =>
        if v = null then null else try DateTime.From(v) otherwise try DateTime.FromText(ToText(v)) otherwise null,

    ToGuidText = (v as any) as nullable text =>
        let
            t = Text.Lower(Text.Trim(ToText(v))),
            normalized = if t = null then null else Text.Replace(Text.Replace(t, "{", ""), "}", "")
        in
            if normalized = null or Text.Length(normalized) <> 36 then null else normalized,

    ConvertByType = (v as any, t as text) as any =>
        if t = "Text" or t = "Note" or t = "Computed" then ToText(v)
        else if t = "Choice" then ToChoiceText(v)
        else if t = "User" or t = "UserMulti" then ToText(v)
        else if t = "Boolean" or t = "Attachments" then ToLogical(v)
        else if t = "Integer" then ToInt64(v)
        else if t = "Number" then ToNumber(v)
        else if t = "DateTime" then ToDateTime(v)
        else if t = "Guid" then ToGuidText(v)
        else ToText(v),

    EnsureColumns = List.Accumulate(
        FieldMap,
        Items,
        (state as table, fm as record) =>
            if List.Contains(Table.ColumnNames(state), fm[Source]) then state
            else Table.AddColumn(state, fm[Source], each null)
    ),

    SelectOnlyMapped = Table.SelectColumns(
        EnsureColumns,
        List.Transform(FieldMap, each _[Source]),
        MissingField.UseNull
    ),

    ConvertColumns = List.Accumulate(
        FieldMap,
        SelectOnlyMapped,
        (state as table, fm as record) =>
            Table.TransformColumns(
                state,
                {
                    {
                        fm[Source],
                        each ConvertByType(_, fm[SpType]),
                        if List.Contains({"Boolean", "Attachments"}, fm[SpType]) then type logical
                        else if fm[SpType] = "Integer" then Int64.Type
                        else if fm[SpType] = "Number" then type number
                        else if fm[SpType] = "DateTime" then type datetime
                        else type text
                    }
                },
                null,
                MissingField.UseNull
            )
    ),

    RenamePairs = List.Transform(FieldMap, each {_[Source], _[Target]}),
    Output = Table.RenameColumns(ConvertColumns, RenamePairs, MissingField.Ignore)
in
    Output
