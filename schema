    // Parameters: set these in Power Query or replace with literals.
    SiteUrl = pSiteUrl,
    ListName = pListName,

    Source = SharePoint.Tables(SiteUrl, [Implementation = "2.0", ViewMode = "All"]),
    Items = Source{[Title = ListName]}[Items],

    FieldMap = {
