    ToText = (v as any) as nullable text =>
        if v = null then
            null
        else if Value.Is(v, type record) then
            if Record.HasFields(v, "Email") then Text.From(v[Email])
            else if Record.HasFields(v, "DisplayName") then Text.From(v[DisplayName])
            else if Record.HasFields(v, "Value") then Text.From(v[Value])
            else Text.FromBinary(Json.FromValue(v), TextEncoding.Utf8)
        else if Value.Is(v, type list) then
            Text.Combine(List.Transform(v, each @ToText(_)), "; ")
        else
            Text.From(v),

    ToChoiceText = (v as any) as nullable text =>
        if v = null then null
        else if Value.Is(v, type record) and Record.HasFields(v, "Value") then Text.From(v[Value])
        else ToText(v),

    ToUserTitleText = (v as any) as nullable text =>
        if v = null then
            null
        else if Value.Is(v, type record) then
            if Record.HasFields(v, "Title") then Text.From(v[Title])
            else if Record.HasFields(v, "DisplayName") then Text.From(v[DisplayName])
            else if Record.HasFields(v, "Email") then Text.From(v[Email])
            else ToText(v)
        else if Value.Is(v, type list) then
            Text.Combine(
                List.RemoveNulls(
                    List.Transform(
                        v,
                        each
                            let u = @ToUserTitleText(_)
                            in if u = null or Text.Trim(u) = "" then null else u
                    )
                ),
                "; "
            )
        else
            ToText(v),

    ToLogical = (v as any) as nullable logical =>
        if v = null then
            null
        else if Value.Is(v, type logical) then
            v
        else
            let
                t = Text.Lower(Text.Trim(ToText(v)))
            in
                if List.Contains({"true", "yes", "y", "1"}, t) then true
                else if List.Contains({"false", "no", "n", "0"}, t) then false
                else null,

    ToInt64 = (v as any) as nullable number =>
        if v = null then null else try Int64.From(v) otherwise try Int64.FromText(ToText(v)) otherwise null,

    ToNumber = (v as any) as nullable number =>
        if v = null then null else try Number.From(v) otherwise try Number.FromText(ToText(v)) otherwise null,

    ToDateTime = (v as any) as nullable datetime =>
        if v = null then null else try DateTime.From(v) otherwise try DateTime.FromText(ToText(v)) otherwise null,

    ToGuidText = (v as any) as nullable text =>
        let
            t = Text.Lower(Text.Trim(ToText(v))),
            normalized = if t = null then null else Text.Replace(Text.Replace(t, "{", ""), "}", "")
        in
            if normalized = null or Text.Length(normalized) <> 36 then null else normalized,

    NormalizeName = (name as nullable text) as text =>
        if name = null then
            ""
        else
            Text.Lower(
                Text.Remove(
                    Text.Replace(Text.Replace(name, "_x002d_", "-"), "_x0020_", " "),
                    {" ", "-", "_", ".", "/", "(", ")"}
                )
            ),

    ResolveSourceColumn = (sourceName as text, availableColumns as list) as nullable text =>
        let
            decoded = Text.Replace(Text.Replace(sourceName, "_x002d_", "-"), "_x0020_", " "),
            withSpacedDash = Text.Replace(decoded, "-", " - "),
            normalizedSource = NormalizeName(sourceName),
            candidates = List.Distinct({sourceName, decoded, withSpacedDash}),
            direct = List.First(List.Select(candidates, each List.Contains(availableColumns, _)), null),
            byNormalized = if direct <> null then direct else List.First(List.Select(availableColumns, each NormalizeName(_) = normalizedSource), null),
            serverFallback =
                if byNormalized <> null then
                    byNormalized
                else if normalizedSource = "servername" and List.Contains(availableColumns, "LinkTitle") then
                    "LinkTitle"
                else if normalizedSource = "servername" and List.Contains(availableColumns, "Title") then
                    "Title"
                else
                    null
        in
            serverFallback,

    ConvertByType = (v as any, t as text) as any =>
        if t = "Text" or t = "Note" or t = "Computed" then ToText(v)
        else if t = "Choice" then ToChoiceText(v)
        else if t = "User" or t = "UserMulti" then ToUserTitleText(v)
        else if t = "Lookup" then ToText(v)
        else if t = "LookupMulti" then ToText(v)
        else if t = "Boolean" or t = "Attachments" then ToLogical(v)
        else if t = "Integer" then ToInt64(v)
        else if t = "Number" then ToNumber(v)
        else if t = "DateTime" then ToDateTime(v)
        else if t = "Guid" then ToGuidText(v)
        else ToText(v),

    AvailableColumns = Table.ColumnNames(Items),
    ResolvedFieldMap = List.Transform(
        FieldMap,
        each Record.AddField(_, "ResolvedSource", ResolveSourceColumn(_[Source], AvailableColumns))
    ),

    Indexed = Table.AddIndexColumn(Items, "__rowid", 0, 1, Int64.Type),

    WithOutputColumns = List.Accumulate(
        ResolvedFieldMap,
        Indexed,
        (state as table, fm as record) =>
            Table.AddColumn(
                state,
                "__out__" & fm[Target],
                each
                    let
                        src = fm[ResolvedSource]
                    in
                        if src = null then null else ConvertByType(Record.FieldOrDefault(_, src, null), fm[SpType]),
                if List.Contains({"Boolean", "Attachments"}, fm[SpType]) then type logical
                else if fm[SpType] = "Integer" then Int64.Type
                else if fm[SpType] = "Number" then type number
                else if fm[SpType] = "DateTime" then type datetime
                else type text
            )
    ),

    OutputColumns = List.Transform(ResolvedFieldMap, each "__out__" & _[Target]),
    SelectedOutputOnly = Table.SelectColumns(WithOutputColumns, OutputColumns, MissingField.UseNull),
    Output = Table.TransformColumnNames(SelectedOutputOnly, each Text.AfterDelimiter(_, "__out__"))
in
    Output
